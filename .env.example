# Новый Telegram-бот поддержки (от @BotFather)
SUPPORT_BOT_TOKEN=

# PrintBox API
# NB: real deployment double-prefixes routes - base must be /api/api, not /api
# (confirmed: https://nurtest.space/api/api/v2/check/ping -> 200 "pong")
PRINTBOX_API_BASE_URL=https://nurtest.space/api/api
PRINTBOX_ADMIN_LOGIN=
PRINTBOX_ADMIN_PASSWORD=
# Если выдан готовый токен вместо логина/пароля - заполнить вместо двух полей выше
PRINTBOX_ADMIN_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Telegram-группа для эскалаций (chat_id, можно узнать через @RawDataBot)
SUPPORT_STAFF_CHAT_ID=

# Telegram_id через запятую - эти юзеры видят админ-меню вместо обычного
ADMIN_TELEGRAM_IDS=

# Бизнес-пороги
# Возврат всегда подтверждает человек - ИИ только готовит рекомендацию.
# Выше этой суммы карточка сотрудника помечается "стоит взглянуть внимательнее".
REFUND_REVIEW_AMOUNT_CAP=1000
NEIGHBOR_WINDOW=5
PRINT_SIGNAL_WINDOW_MINUTES=5
SESSION_TIMEOUT_MINUTES=10

# Своя БД для тикетов/аудита
SUPPORT_BOT_DB_PATH=./support_bot.sqlite3

# Кто попадает к диалоговому агенту вместо меню: off | admin | all
# admin — только id из ADMIN_TELEGRAM_IDS. Неизвестное значение = off.
AGENT_MODE=off
